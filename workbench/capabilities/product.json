{
  "id": "product",
  "name": "历史正式研究模式",
  "description": "仅在明确要求 0–12 章正式研究或大型跨团队材料时使用历史 T1–T4；日常新品默认使用快速迭代路径。",
  "enabled": true,
  "tasks": [
    {
      "id": "new-product",
      "name": "完整新品分析",
      "description": "从背景、用户和竞品到定位、MVP 与执行建议，沿用 Heart Rate 新品分析结构。",
      "template": "knowledge/templates/t1-new-product-analysis.md",
      "output": "新品需求分析",
      "tools": [
        "project-search",
        "knowledge-search",
        "document-parser",
        "codex"
      ],
      "query": "新品需求分析 Heart Rate 市场 用户 竞品 定位 MVP"
      ,"modes": ["full"]
    },
    {
      "id": "framework",
      "name": "产品框架与版本规划",
      "description": "确定核心流程、功能边界与版本顺序。",
      "template": "knowledge/templates/t2-product-framework-version-plan.md",
      "output": "产品框架与版本规划",
      "tools": ["project-search", "knowledge-search", "codex"],
      "query": "产品框架 MVP 版本规划"
      ,"recommended_upstream": "product/new-product"
      ,"modes": ["full"]
    },
    {
      "id": "prd",
      "name": "需求与原型说明",
      "description": "输出中文需求、页面说明、状态和异常；原型文件另行制作。",
      "template": "knowledge/templates/t3-prd-prototype-handoff.md",
      "output": "需求与原型说明",
      "tools": ["project-search", "knowledge-search", "codex"],
      "query": "PRD 原型 中文 状态 异常"
      ,"recommended_upstream": "product/framework"
      ,"modes": ["full"]
    },
    {
      "id": "acceptance",
      "name": "埋点与验收方案",
      "description": "整理核心事件、验收条件和测试场景。",
      "template": "knowledge/templates/t4-tracking-qa-acceptance.md",
      "output": "埋点与验收方案",
      "tools": ["project-search", "knowledge-search", "codex"],
      "query": "埋点 QA 验收"
      ,"modes": ["full"],
      "hidden": true
    },
    {
      "id": "acceptance-plan",
      "name": "F3 开发验收清单（正式模式可选）",
      "description": "在同一份清单中记录开发前预期与开发后实测、证据、修改和复测。",
      "template": "knowledge/templates/f3-development-acceptance.md",
      "output": "F3 开发验收清单",
      "tools": ["project-search", "knowledge-search", "codex"],
      "query": "开发验收 QA 实测 日志 截图 复测",
      "recommended_upstream": "product/prd",
      "review_policy": "acceptance",
      "modes": ["full"]
    },
    {
      "id": "acceptance-run",
      "name": "T4 真实构建验收",
      "description": "基于构建、设备、日志和录像记录真实结果，给出 Accepted、Conditional 或 Rejected。",
      "template": "knowledge/templates/t4-acceptance-run.md",
      "output": "T4 真实构建验收记录",
      "tools": ["project-search", "knowledge-search", "document-parser", "codex"],
      "query": "真实构建 设备 日志 录像 复测 验收",
      "review_policy": "acceptance",
      "modes": ["full"],
      "hidden": true
    }
  ]
}
